{
  "expo": {
    "name": "Rollio",
    "slug": "Rollio",
    "version": "2.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon-light.png",
    "scheme": "rollio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/rollio-glass.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.davitpodosyan.rollio",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Rollio requires access to the camera to add images to your frames.",
        "NSPhotoLibraryUsageDescription": "Rollio requires access to the photo library to add images to your frames.",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.davitpodosyan.rollio",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "en": "./native-locales/en.json",
      "ja": "./native-locales/ja.json",
      "ko": "./native-locales/ko.json"
    },
    "plugins": [
      "expo-router",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E5E0FF",
          "image": "./assets/images/splash-icon-light.png",
          "dark": {
            "backgroundColor": "#100528",
            "image": "./assets/images/splash-icon-light.png"
          },
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": false,
          "android": {
            "enableFTS": false,
            "useSQLCipher": false
          },
          "ios": {
            "customBuildFlags": [
              "-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "$(PRODUCT_NAME) needs access to your Camera.",
          "enableLocation": false
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "ja",
            "ko"
          ]
        }
      ],
      "@react-native-vector-icons/material-icons",
      "expo-sharing",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "$(PRODUCT_NAME) saves where each frame was shot, only when you switch Save Location on for a frame.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "RollWidget",
              "displayName": "Current Roll",
              "description": "The roll in your camera and its frame count.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "widgets/RollWidget.tsx",
                "configuration": {
                  "title": "Current Roll",
                  "description": "Choose which roll this widget shows.",
                  "parameters": {
                    "roll": {
                      "title": "Roll",
                      "type": "enum",
                      "dynamic": true,
                      "values": [
                        {
                          "name": "Latest roll",
                          "value": "latest"
                        }
                      ],
                      "default": "latest"
                    }
                  }
                }
              }
            },
            {
              "name": "LightMeterWidget",
              "displayName": "Light Meter",
              "description": "Open the light meter.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular"
                ],
                "initialLayout": "widgets/LightMeterWidget.tsx"
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RollWidget",
              "label": "Current Roll",
              "description": "The roll in your camera, with buttons to log a frame and open the light meter.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/roll.png",
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "RollWidgetWide",
              "label": "Current Roll (wide)",
              "description": "The roll in your camera, with Log Frame and Light Meter buttons.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/roll-wide.png",
              "widgetFeatures": "reconfigurable|configuration_optional"
            }
          ]
        }
      ],
      "./plugins/withDeepLinkAfterProcessDeath"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2c427b5f-0d47-41fe-8dce-7581f147ce28"
      }
    },
    "owner": "davepodosyan"
  }
}
